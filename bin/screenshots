#!/usr/bin/env python3
"""The screenshots panel's helper (run by services/Sys.qml).

  screenshots list <folder> <ext,ext,...>
      every picture in <folder> (not its subfolders) with one of those extensions, newest first:
      "<modified, s since 1970>\t<width>\t<height>\t<path>" per line. The size is read from the file's
      header (PNG, JPEG, GIF, WebP; 0 0 when it can't be read), no picture is decoded.

  screenshots transfer
      reads file paths on stdin, one per line, and answers each with "<key>\t<path>": a key of the
      desktop's file transfer portal (org.freedesktop.portal.FileTransfer) holding that file. Dropped
      with the mime type application/vnd.portal.filetransfer, the key lets a sandboxed app (a Flatpak
      browser that can only read Downloads) receive the file itself; it's how Files hands files over.
      The keys stay valid while this process runs (the transfers belong to its connection to the bus).
      "<error>\t<path>" when it couldn't be done.
"""
import os
import struct
import sys


def size_of(path):
    try:
        with open(path, "rb") as f:
            head = f.read(32)
            if head[:8] == b"\x89PNG\r\n\x1a\n":
                return struct.unpack(">II", head[16:24])
            if head[:6] in (b"GIF87a", b"GIF89a"):
                return struct.unpack("<HH", head[6:10])
            if head[:4] == b"RIFF" and head[8:12] == b"WEBP":
                kind = head[12:16]
                if kind == b"VP8X":
                    return (int.from_bytes(head[24:27], "little") + 1, int.from_bytes(head[27:30], "little") + 1)
                if kind == b"VP8 ":
                    w, h = struct.unpack("<HH", head[26:30])
                    return (w & 0x3FFF, h & 0x3FFF)
                if kind == b"VP8L":
                    b = head[21:25]
                    w = 1 + (((b[1] & 0x3F) << 8) | b[0])
                    h = 1 + (((b[3] & 0xF) << 10) | (b[2] << 2) | ((b[1] & 0xC0) >> 6))
                    return (w, h)
            if head[:2] == b"\xff\xd8":
                f.seek(2)
                while True:
                    marker = f.read(2)
                    if len(marker) < 2 or marker[0] != 0xFF:
                        break
                    if marker[1] in (0xD8, 0x01) or 0xD0 <= marker[1] <= 0xD7:
                        continue
                    length = struct.unpack(">H", f.read(2))[0]
                    if 0xC0 <= marker[1] <= 0xCF and marker[1] not in (0xC4, 0xC8, 0xCC):
                        h, w = struct.unpack(">xHH", f.read(5))
                        return (w, h)
                    f.seek(length - 2, 1)
    except (OSError, struct.error):
        pass
    return (0, 0)


def list_pictures(folder, exts):
    exts = {"." + e.lower().lstrip(".") for e in exts.split(",") if e}
    out = []
    try:
        entries = list(os.scandir(os.path.expanduser(folder)))
    except OSError:
        entries = []
    for e in entries:
        if not e.is_file() or os.path.splitext(e.name)[1].lower() not in exts:
            continue
        try:
            t = e.stat().st_mtime
        except OSError:
            continue
        w, h = size_of(e.path)
        out.append((t, w, h, e.path))
    out.sort(key=lambda r: (-r[0], r[3]))
    sys.stdout.write("".join(f"{t:.3f}\t{w}\t{h}\t{p}\n" for t, w, h, p in out))


def transfer():
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib

    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    args = ("org.freedesktop.portal.Documents", "/org/freedesktop/portal/documents", "org.freedesktop.portal.FileTransfer")
    for line in sys.stdin:
        path = line.rstrip("\n")
        if not path:
            continue
        try:
            opts = {"writable": GLib.Variant("b", False), "autostop": GLib.Variant("b", False)}
            key = bus.call_sync(*args, "StartTransfer", GLib.Variant("(a{sv})", (opts,)), GLib.VariantType("(s)"),
                                Gio.DBusCallFlags.NONE, -1, None).unpack()[0]
            fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC)
            fds = Gio.UnixFDList.new()
            index = fds.append(fd)
            os.close(fd)
            bus.call_with_unix_fd_list_sync(*args, "AddFiles", GLib.Variant("(saha{sv})", (key, [index], {})), None,
                                            Gio.DBusCallFlags.NONE, -1, fds, None)
            print(f"{key}\t{path}", flush=True)
        except Exception as e:  # no portal, file gone...
            print(f"error: {e}".replace("\t", " ").replace("\n", " ") + f"\t{path}", file=sys.stdout, flush=True)


if __name__ == "__main__":
    if len(sys.argv) >= 4 and sys.argv[1] == "list":
        list_pictures(sys.argv[2], sys.argv[3])
    elif len(sys.argv) >= 2 and sys.argv[1] == "transfer":
        transfer()
    else:
        sys.exit(__doc__)
